{
  "name": "workout-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "expo start --web",
    "dev:api": "wrangler dev worker/index.ts --assets dist/client --binding OWNER_EMAIL=owner@example.com --binding AUTH_SESSION_SECRET=local-development-secret-change-me --binding GOOGLE_WEB_CLIENT_ID=local-development.apps.googleusercontent.com",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build": "node scripts/build-sites.mjs",
    "build:web": "expo export --platform web --output-dir dist/client --clear",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "start": "expo start",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "drizzle-orm": "0.45.2",
    "expo": "~57.0.7",
    "expo-constants": "^57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-linking": "^57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "jose": "^6.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "^1.0.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.1",
    "typescript": "~6.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "main": "expo-router/entry"
}
