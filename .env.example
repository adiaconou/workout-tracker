# Comma-separated ChatGPT or Google account emails allowed to use the app.
ALLOWED_USER_EMAILS=

# Backward-compatible primary owner, always combined with ALLOWED_USER_EMAILS.
OWNER_EMAIL=

# Server-only secret used to sign native access sessions.
AUTH_SESSION_SECRET=

# Server-side Google OAuth client ID used to verify native ID tokens.
GOOGLE_WEB_CLIENT_ID=

# Server-only. Configure the production value as a secret in Sites.
OPENAI_API_KEY=

# Optional. The coach falls back to the balanced current model.
OPENAI_DEFAULT_MODEL=gpt-5.6-terra

# Optional for compatible gateways and local testing.
OPENAI_API_BASE_URL=https://api.openai.com/v1
