{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "expo-env.d.ts",
    "cloudflare.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "legacy",
    "src/features/routines/routine-detail-screen (1).tsx"
  ]
}
