{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "worker/**/*.ts",
    "domain/**/*.ts",
    "application/**/*.ts",
    "infrastructure/**/*.ts",
    "lib/**/*.ts",
    "db/**/*.ts",
    "tests/**/*.ts",
    "expo-env.d.ts",
    "cloudflare.d.ts"
  ],
  "exclude": ["node_modules", "dist", "legacy"]
}
